4 0 obj
<<
/Length 161
% Length of the content stream in bytes (must match actual byte count)
>>
stream
% ===== YELLOW BOX =====
% DIFFERENCE: Using RGB color instead of grayscale
% 1 1 0 rg = Yellow (RGB: red=1, green=1, blue=0)
1 1 0 rg
% Set fill color to yellow using RGB color space
% rg = RGB non-stroking (fill) color operator
100 600 m
% Move to point (100, 600) - bottom-left corner of rectangle
400 600 l
% Line to (400, 600) - bottom-right corner
400 700 l
% Line to (400, 700) - top-right corner
100 700 l
% Line to (100, 700) - top-left corner
f
% Fill the path (creates filled yellow rectangle)

% ===== TEXT INSIDE BOX (BLUE COLOR) =====
BT
% Begin Text object
/F1 24 Tf
% Set font F1 at size 24 points
% Tf = Text font operator
% DIFFERENCE: Font size is 24 points (can be changed to any size)
0 0 1 rg
% Set text color to blue (RGB: red=0, green=0, blue=1)
% DIFFERENCE: Text color is different from box color (blue vs yellow)
% rg = RGB non-stroking color (affects text fill)
120 650 Td
% Move text position to (120, 650) - inside the yellow box
% Td = Text position operator (relative positioning)
(Text in Box) Tj
% Show the text "Text in Box"
% Tj = Show text operator
ET
% End Text object

% ===== TEXT BELOW BOX (GREY COLOR) =====
BT
% Begin new Text object
/F1 18 Tf
% Set font F1 at size 18 points
% DIFFERENCE: Smaller font size (18 vs 24)
0.5 0.5 0.5 rg
% Set text color to grey (RGB: red=0.5, green=0.5, blue=0.5)
% DIFFERENCE: Using grey color for text below the box
% This is equivalent to: 0.5 g (grayscale)
100 550 Td
% Move text position to (100, 550) - below the yellow box
(Grey text below) Tj
% Show the text "Grey text below"
ET
% End Text object
endstream
endobj
5 0 obj
<<
/Type /Font
/Subtype /Type1
/BaseFont /Helvetica
% Helvetica is a standard PDF font (no external file needed)
% Other options: /Times-Roman, /Courier, /Helvetica-Bold, etc.
>>
endobj
